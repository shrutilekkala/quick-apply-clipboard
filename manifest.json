{
  "manifest_version": 3,
  "name": "QuickApply Clipboard",
  "version": "1.1.0",
  "description": "Save reusable job-application snippets and keep local copies of PDF and Word documents.",
  "permissions": ["storage", "unlimitedStorage", "sidePanel", "contextMenus"],
  "action": {
    "default_title": "Open QuickApply Clipboard"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  }
}
